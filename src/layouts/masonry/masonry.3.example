html!{
    <Masonry gutter=true columns={[
        AttrValue::from("1").all(),
        AttrValue::from("2").md(),
        AttrValue::from("3").lg(),
        AttrValue::from("4").xl(),
    ]}>
        <LayoutItem>{"Item #1"}</LayoutItem>
        <LayoutItem>{"Item #2 - taller content here to demonstrate masonry flow"}</LayoutItem>
        <LayoutItem>{"Item #3"}</LayoutItem>
        <LayoutItem>{"Item #4"}</LayoutItem>
        <LayoutItem>{"Item #5"}</LayoutItem>
        <LayoutItem>{"Item #6 - another taller one"}</LayoutItem>
        <LayoutItem>{"Item #7"}</LayoutItem>
        <LayoutItem>{"Item #8"}</LayoutItem>
    </Masonry>
}
