{
    let date = jiff::Timestamp::now() - jiff::SignedDuration::from_hours(1);

    html!(
        <Timestamp
            {date}
            date_format={TimestampFormat::Full}
            time_format={TimestampFormat::Short}
            tooltip={TimestampTooltip::default_utc()}
        >
            { "1 hour ago" }
        </Timestamp>
    )
}
