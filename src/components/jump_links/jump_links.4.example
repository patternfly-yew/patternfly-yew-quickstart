html! {
    <JumpLinks
        aria_label="Jump to example sections"
        label={html!({ "Sections" })}
    >
        <JumpLinksItem href="#section-1">{ "Section 1" }</JumpLinksItem>
        <JumpLinksItem href="#section-2" active=true>{ "Section 2 (active)" }</JumpLinksItem>
        <JumpLinksItem href="#section-3">{ "Section 3" }</JumpLinksItem>
    </JumpLinks>
}
